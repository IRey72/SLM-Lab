<?xml version="1.0" encoding="utf-8"?>
<!--
  FFXI "We Are Vana'diel" chronograph-style watch face (Watch Face Format v1).
  Art is generated by tools/generate_assets.py; hand/sub-dial geometry below
  must match the layout constants in that script.

  Sub-dials:  9 o'clock San d'Oria = day of week
              3 o'clock Bastok     = battery (E..F over 300 degrees)
              6 o'clock Windurst   = 24-hour hand
  No seconds hand (hour and minute only).
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#ff000000">

    <!-- Interactive (active) dial -->
    <Group name="active_dial" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="dial" />
      </PartImage>
      <!-- Date window (frame is part of dial.png) -->
      <PartText x="311" y="316" width="34" height="24">
        <Text align="CENTER">
          <Font family="cinzel_bold" size="17" color="#ff141414">
            <Template>%d<Parameter expression="[DAY]" /></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- Ambient (always-on) dial -->
    <Group name="ambient_dial" x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="dial_ambient" />
      </PartImage>
    </Group>

    <!-- San d'Oria sub-dial (9 o'clock): day of week, SU at top -->
    <PartImage name="sub_sandoria" x="117" y="176" width="16" height="62" pivotX="0.5" pivotY="0.7903">
      <Transform target="angle" value="([DAY_OF_WEEK] - 1) * 51.428571" />
      <Image resource="hand_sub" />
    </PartImage>

    <!-- Bastok sub-dial (3 o'clock): battery, E at -150deg, F at +150deg -->
    <PartImage name="sub_bastok" x="317" y="176" width="16" height="62" pivotX="0.5" pivotY="0.7903">
      <Transform target="angle" value="-150 + [BATTERY_PERCENT] * 3" />
      <Image resource="hand_sub" />
    </PartImage>

    <!-- Windurst sub-dial (6 o'clock): 24-hour hand, 24 at top -->
    <PartImage name="sub_windurst" x="217" y="276" width="16" height="62" pivotX="0.5" pivotY="0.7903">
      <Transform target="angle" value="([HOUR_0_23] + [MINUTE] / 60) * 15" />
      <Image resource="hand_sub" />
    </PartImage>

    <!-- Hour + minute -->
    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hand_hour" x="209" y="102" width="32" height="150" pivotX="0.5" pivotY="0.8200" />
      <MinuteHand resource="hand_minute" x="211" y="40" width="28" height="216" pivotX="0.5" pivotY="0.8565" />
    </AnalogClock>

    <!-- Polished centre cap: static, above the hands, so its highlight never rotates -->
    <PartImage name="cap" x="212" y="212" width="26" height="26">
      <Image resource="cap" />
    </PartImage>

    <!-- Glass reflection over everything; off in ambient -->
    <Group name="glass" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="glass" />
      </PartImage>
    </Group>

  </Scene>
</WatchFace>
