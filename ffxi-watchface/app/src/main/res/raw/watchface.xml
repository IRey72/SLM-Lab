<?xml version="1.0" encoding="utf-8"?>
<!--
  FFXI "We Are Vana'diel" chronograph-style watch face (Watch Face Format v1).
  Art is generated by tools/generate_assets.py, which also writes the hand and
  cap geometry below (don't hand-edit those numbers; re-run the script).

  Styles (long-press the face > Customize > Style):
    classic  realistic navy dial with full-colour crests
    dark     the outline "dark chronograph" look with line-art crests
  Sub-dials:  9 o'clock San d'Oria = day of week
              3 o'clock Bastok     = battery (E..F over 300 degrees)
              6 o'clock Windurst   = 24-hour hand
  No seconds hand (hour and minute only).
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <UserConfigurations>
    <ListConfiguration id="style" displayName="@string/style_label" defaultValue="classic">
      <ListOption id="classic" displayName="@string/style_classic" />
      <ListOption id="dark" displayName="@string/style_dark" />
    </ListConfiguration>
  </UserConfigurations>

  <Scene backgroundColor="#ff000000">

    <!-- Interactive (active) dial for the chosen style -->
    <ListConfiguration id="style">
      <ListOption id="classic">
        <Group name="classic_dial" x="0" y="0" width="450" height="450">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial" />
          </PartImage>
          <!-- Date window (frame is part of dial.png) -->
          <PartText x="311" y="316" width="34" height="24">
            <Text align="CENTER">
              <Font family="cinzel_bold" size="17" color="#ff141414">
                <Template>%d<Parameter expression="[DAY]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Group>
      </ListOption>
      <ListOption id="dark">
        <Group name="dark_dial" x="0" y="0" width="450" height="450">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial_dark" />
          </PartImage>
          <PartText x="311" y="316" width="34" height="24">
            <Text align="CENTER">
              <Font family="cinzel_bold" size="17" color="#ffbebebe">
                <Template>%d<Parameter expression="[DAY]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Group>
      </ListOption>
    </ListConfiguration>

    <!-- Ambient (always-on) dial, shared by both styles -->
    <Group name="ambient_dial" x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="dial_ambient" />
      </PartImage>
    </Group>

    <!-- Hands for the chosen style: photographed steel (Classic) or thin outlines (Dark) -->
    <ListConfiguration id="style">
      <ListOption id="classic">
        <Group name="classic_hands" x="0" y="0" width="450" height="450">
          <!-- San d'Oria sub-dial (9 o'clock): day of week, SU at top -->
          <PartImage name="sub_sandoria" x="118" y="176" width="14" height="68" pivotX="0.5" pivotY="0.7206">
            <Transform target="angle" value="([DAY_OF_WEEK] - 1) * 51.428571" />
            <Image resource="hand_sub" />
          </PartImage>
          <!-- Bastok sub-dial (3 o'clock): battery, E at -150deg, F at +150deg -->
          <PartImage name="sub_bastok" x="318" y="176" width="14" height="68" pivotX="0.5" pivotY="0.7206">
            <Transform target="angle" value="-150 + [BATTERY_PERCENT] * 3" />
            <Image resource="hand_sub" />
          </PartImage>
          <!-- Windurst sub-dial (6 o'clock): 24-hour hand, 24 at top -->
          <PartImage name="sub_windurst" x="218" y="276" width="14" height="68" pivotX="0.5" pivotY="0.7206">
            <Transform target="angle" value="([HOUR_0_23] + [MINUTE] / 60) * 15" />
            <Image resource="hand_sub" />
          </PartImage>
          <AnalogClock x="0" y="0" width="450" height="450">
            <HourHand resource="hand_hour" x="212" y="102" width="26" height="158" pivotX="0.5" pivotY="0.7785" />
            <MinuteHand resource="hand_minute" x="212" y="38" width="26" height="228" pivotX="0.5" pivotY="0.8202" />
          </AnalogClock>
          <!-- Centre cap: static, above the hands -->
          <PartImage name="cap" x="214" y="214" width="22" height="22">
            <Image resource="cap" />
          </PartImage>
        </Group>
      </ListOption>
      <ListOption id="dark">
        <Group name="dark_hands" x="0" y="0" width="450" height="450">
          <!-- San d'Oria sub-dial (9 o'clock): day of week, SU at top -->
          <PartImage name="sub_sandoria_dark" x="119" y="179" width="12" height="58" pivotX="0.5" pivotY="0.7931">
            <Transform target="angle" value="([DAY_OF_WEEK] - 1) * 51.428571" />
            <Image resource="hand_sub_dark" />
          </PartImage>
          <!-- Bastok sub-dial (3 o'clock): battery, E at -150deg, F at +150deg -->
          <PartImage name="sub_bastok_dark" x="319" y="179" width="12" height="58" pivotX="0.5" pivotY="0.7931">
            <Transform target="angle" value="-150 + [BATTERY_PERCENT] * 3" />
            <Image resource="hand_sub_dark" />
          </PartImage>
          <!-- Windurst sub-dial (6 o'clock): 24-hour hand, 24 at top -->
          <PartImage name="sub_windurst_dark" x="219" y="279" width="12" height="58" pivotX="0.5" pivotY="0.7931">
            <Transform target="angle" value="([HOUR_0_23] + [MINUTE] / 60) * 15" />
            <Image resource="hand_sub_dark" />
          </PartImage>
          <AnalogClock x="0" y="0" width="450" height="450">
            <HourHand resource="hand_hour_dark" x="218" y="111" width="14" height="132" pivotX="0.5" pivotY="0.8636" />
            <MinuteHand resource="hand_minute_dark" x="219" y="43" width="12" height="204" pivotX="0.5" pivotY="0.8922" />
          </AnalogClock>
          <!-- Centre cap: static, above the hands -->
          <PartImage name="cap_dark" x="218" y="218" width="14" height="14">
            <Image resource="cap_dark" />
          </PartImage>
        </Group>
      </ListOption>
    </ListConfiguration>

    <!-- Glass reflection (classic style only; off in ambient) -->
    <ListConfiguration id="style">
      <ListOption id="classic">
        <Group name="glass" x="0" y="0" width="450" height="450">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="glass" />
          </PartImage>
        </Group>
      </ListOption>
      <ListOption id="dark">
        <Group name="no_glass" x="0" y="0" width="450" height="450" />
      </ListOption>
    </ListConfiguration>

  </Scene>
</WatchFace>
