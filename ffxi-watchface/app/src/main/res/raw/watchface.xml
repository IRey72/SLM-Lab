        </Group>
        <Group name="light_ambient" x="0" y="0" width="450" height="450" alpha="0">
          <Variant mode="AMBIENT" target="alpha" value="255" />
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial_ambient" />
          </PartImage>
        </Group>
      </ListOption>
      <ListOption id="vanadiel">
        <!-- Vana'diel time = 25x Earth time; one Earth day is exactly 25 Vana'diel days, so the
             time of day only needs the UTC time of day (derived exactly from local seconds plus
             the offset, rounded to 15 min). Weekday: days since 2002-06-23 15:00 UTC, +6, mod 8. -->
        <Group name="vanadiel_dial" x="0" y="0" width="450" height="450">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial_vana" />
